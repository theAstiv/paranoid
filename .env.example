# Paranoid — environment variable reference
# Copy this file to .env and fill in your values.
# Use env_file: .env in docker-compose.yml (NOT environment: ${VAR} interpolation —
# compose silently truncates long values, breaking API keys).

# ─── Provider ─────────────────────────────────────────────────────────────────

# Anthropic (Claude) — recommended
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI (GPT-4)
OPENAI_API_KEY=sk-xxx

# Ollama (local LLMs, no API key required)
# Docker: use host.docker.internal to reach Ollama running on the host machine.
# CLI / local dev: use localhost:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Active provider: anthropic | openai | ollama
DEFAULT_PROVIDER=anthropic

# Default model name
# Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-5-20251001
# OpenAI:    gpt-4o, gpt-4o-mini, gpt-4.1
# Ollama:    llama3.1:8b, qwen2.5:14b, mistral-nemo (need 32K+ context)
DEFAULT_MODEL=claude-sonnet-4-20250514

# Fast model for extraction/enrichment steps (Anthropic only, optional).
# Uses a Haiku-class model to cut API cost without sacrificing threat quality.
# Set to the same value as DEFAULT_MODEL to disable fast routing.
FAST_MODEL=claude-haiku-4-5-20251001

# ─── Pipeline ─────────────────────────────────────────────────────────────────

# Default iteration count (1–15)
DEFAULT_ITERATIONS=3

# Hard limits (validated at startup)
MAX_ITERATION_COUNT=15
MIN_ITERATION_COUNT=1

# Minimum iterations before any early-stop condition (gap satisfied,
# dedup saturation) can fire. Suppresses early stops below this floor.
MIN_ITERATIONS=1

# Stop when >= this fraction of new threats in an iteration are cross-iteration
# duplicates. Range 0.0–1.0; 0.7 = stop when 70% or more are duplicates.
DEDUP_SATURATION_THRESHOLD=0.7

# LLM sampling temperature (0.0–1.0)
DEFAULT_TEMPERATURE=0.2

# Per-run pipeline timeout in minutes
PIPELINE_TIMEOUT_MINUTES=30

# ─── Database ─────────────────────────────────────────────────────────────────

DB_PATH=./data/paranoid.db

# ─── Server ───────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Allowed CORS origins. Use * to allow all (development only).
# Set to your concrete origin(s) in production: https://paranoid.yourcompany.com
CORS_ORIGINS=*

# ─── Security and Auth ────────────────────────────────────────────────────────

# false (default): anonymous admin mode — anyone with network access is instance admin.
# true: require login. Auto-creates an 'admin' user on first startup.
PARANOID_REQUIRE_AUTH=false

# Password for the auto-created 'admin' account (used when PARANOID_REQUIRE_AUTH=true).
# If unset: a random password is generated and printed once to the container log.
# PARANOID_ADMIN_PASSWORD=your-admin-password

# JWT signing key. Falls back to PBKDF2(CONFIG_SECRET), then an ephemeral per-process key.
# Set explicitly in production to keep sessions valid across restarts.
# JWT_SECRET=change-me-32-chars-minimum

# Optional shared secret protecting PATCH /api/config (Settings page in web UI)
# and used as the source for PAT encryption key derivation.
# Warning: rotating this value after PATs are stored invalidates all stored credentials.
# CONFIG_SECRET=your-secret-here

# Concrete origins for CSRF protection on state-mutating requests.
# Default: localhost:8000. Set to your public deployment origin(s) when exposing beyond localhost.
# ALLOWED_ORIGINS=https://paranoid.yourcompany.com

# ─── Embeddings ───────────────────────────────────────────────────────────────

# fastembed model (baked into Docker image at build time via EMBEDDING_MODEL build arg)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cosine similarity threshold for threat deduplication (0.0–1.0)
SIMILARITY_THRESHOLD=0.85

# Top-K results from vector search per pipeline step
RAG_TOP_K=10

# ─── CLI Remote Auth ──────────────────────────────────────────────────────────

# URL of a remote Paranoid server for CLI commands (paranoid models list, etc.).
# If unset, the CLI uses the local SQLite database at ~/.paranoid/paranoid.db.
# PARANOID_URL=https://paranoid.yourcompany.com

# PAT for authenticating CLI commands against a remote server.
# Equivalent to passing --token on every command.
# PARANOID_TOKEN=pat_xxx

# ─── Advanced ─────────────────────────────────────────────────────────────────

# Explicit path to the context-link binary (for --code flag and code sources).
# If unset: searches ./bin/context-link, then PATH.
# CONTEXT_LINK_BINARY=/usr/local/bin/context-link

# Extra git clone hosts beyond github.com, gitlab.com, bitbucket.org.
# Comma-separated exact hostnames (no wildcards, no protocols).
# ADDITIONAL_GIT_HOSTS=git.company.com,git.internal.net

# Restrict which rule engine seed collections are loaded at startup.
# Default: all 16 collections. Unknown names raise a startup error.
# SEED_COLLECTIONS=stride,auth,cloud
