# Benchmark / live-E2E harness configuration.
# Copy to tests/bench/bench.env (gitignored) and fill in what you have. Real
# environment variables override anything here. A model slot left empty is
# skipped and reported as skipped; nothing makes a live call until you run
# `python -m tests.bench run ...`, and `run` refuses to start without
# BENCH_MAX_COST_USD.

# --- Credentials -------------------------------------------------------------
# Bedrock uses the standard AWS chain. Prefer a named profile:
AWS_REGION=
AWS_PROFILE=
# ...or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN in
# your shell instead of this file. None of these are ever written to artifacts.

# Direct OpenAI (light arm only):
OPENAI_API_KEY=

# --- Model IDs (Bedrock model ID or inference profile, from SB1) -------------
BENCH_MODEL_OPUS_55=
BENCH_MODEL_FABLE_51=
BENCH_MODEL_SONNET_55=
BENCH_MODEL_SONNET_5=
BENCH_MODEL_HAIKU_55=
BENCH_MODEL_HAIKU_45=
BENCH_MODEL_GPT_OSS_120B=
BENCH_MODEL_GPT_OSS_20B=
BENCH_MODEL_QWEN=
BENCH_MODEL_DEEPSEEK=
# Direct OpenAI model (defaults to gpt-4.1 when left empty):
BENCH_MODEL_OPENAI_DIRECT=

# Optional per-slot override of whether a model is sent images (true/false),
# until the spike settles it. Defaults: Claude and OPENAI_DIRECT true, others false.
# BENCH_IMAGES_QWEN=false

# --- Routing benchmark (BM2/BM3): slot names, not model IDs -------------------
BENCH_ROUTING_MAIN=OPUS_55
BENCH_ROUTING_FAST=HAIKU_55

# --- Pytest live suites (tests/live/) ------------------------------------------
# Empty = direct Anthropic with DEFAULT_MODEL from the repo's .env. A slot name
# (e.g. SONNET_55) uses that slot's provider and model ID from this file; or set
# BENCH_LIVE_PROVIDER (anthropic|bedrock|openai|ollama) plus a raw model ID.
BENCH_LIVE_MODEL=
BENCH_LIVE_PROVIDER=

# --- Spend and limits ---------------------------------------------------------
# Required for `run`. Hard cap for one invocation, in the price file's currency.
BENCH_MAX_COST_USD=
BENCH_PRICES_FILE=tests/bench/prices.json
# Effort for Claude runs (direct Anthropic via ANTHROPIC_EFFORT; Bedrock once P-3 lands).
BENCH_EFFORT=medium
BENCH_RUN_TIMEOUT_S=1800

# --- Optional inputs ----------------------------------------------------------
# A small local git repo for code-as-input (E2E-5, BM13); skipped when empty.
BENCH_CODE_REPO=
# BM1: directory of the encrypted malware zips from scripts/fetch_bm1_samples.py.
# Never install or execute these; they are scanned as files only.
BENCH_MALWARE_DIR=
# BM1: where one sample at a time is decrypted for a scan (outside the repo;
# antivirus-excluded, or inside WSL / a VM). Emptied after each sample.
BENCH_MALWARE_SCRATCH=
# Results root (default data/benchmarks, gitignored).
BENCH_OUT_DIR=
